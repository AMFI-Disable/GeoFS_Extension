{
  "name": "geofs-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Unified Manifest V3 Chrome Extension for GeoFS V3.x and V4.x",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "build": "node scripts/build.mjs",
    "build:unpacked": "node scripts/build.mjs --unpacked",
    "package": "node scripts/build.mjs --zip"
  },
  "dependencies": {
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "@types/chrome": "^0.0.295",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
