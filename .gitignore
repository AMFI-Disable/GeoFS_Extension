# ==============================================================================
# GeoFS_Extension .gitignore
# ==============================================================================
# Controls file visibility and repository hygiene:
# - Hides transient build artifacts, machine-specific caches, editor states, and secrets.
# - Preserves active working files, configuration definitions, and extension assets.
# ==============================================================================

# ==============================================================================
# SECTION 1: WORKING & PRESERVED FILES (Explicit Whitelists)
# ==============================================================================
!src/
!public/
!scripts/
!tests/
!userscripts/
!agents.md
!readme*.md
!changelog.md
!docs/
!security.md
!license
!.gitignore
!.github/
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!vitest.config.ts

# ==============================================================================
# SECTION 2: HIDDEN & IGNORED ARTIFACTS
# ==============================================================================

# 2.1 macOS System & Volume Metadata
.DS_Store
.DS_Store?
.ds_store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Icon?
Thumbs.db

# 2.2 Package Managers & Local Dependencies
node_modules/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2.3 Build Products, Caches & Output Directories
dist/
/GeoFS Extension/
build/
release/
coverage/
.cache/
*.tgz
*.zip

# 2.4 Environment Secrets, Private Keys & Tokens
.env*
*.key
*.pem
*.token
credentials.json
token.json
*secret*

# 2.5 Diagnostics, Logs & Telemetry
*.log
logs/

# 2.6 IDEs, Editors & User Workspace State
.vscode/
.idea/
*.swp
*.swo
*~
.gemini/
.claude/
.cursor/
.windsurf/
.codex/
antigravity.json
.nodeterm/

# 2.7 Temporary Files & Scratchpads
*.tmp
*.temp
*.bak
tmp/
scratch/
