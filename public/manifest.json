{
  "manifest_version": 3,
  "name": "GeoFS Extension",
  "version": "0.1.0",
  "description": "Unified Manifest V3 flight simulation suite for GeoFS V3.x and V4.x.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.geo-fs.com/*"],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "GeoFS Extension",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.geo-fs.com/geofs.php*",
        "https://beta.geo-fs.com/geofs.php*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.geo-fs.com/geofs.php*",
        "https://beta.geo-fs.com/geofs.php*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
