{
  "manifest_version": 3,
  "name": "GeoFS Extension",
  "version": "0.3.0",
  "description": "Unified Manifest V3 flight simulation suite for GeoFS V3.x and V4.x.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": ["*://*.geo-fs.com/*", "*://geo-fs.com/*"],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "GeoFS Extension",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "web_accessible_resources": [{
    "resources": ["audio/*", "assets/*"],
    "matches": ["*://*.geo-fs.com/*", "*://geo-fs.com/*"]
  }],
  "content_scripts": [
    {
      "matches": [
        "*://*.geo-fs.com/*",
        "*://geo-fs.com/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.geo-fs.com/*",
        "*://geo-fs.com/*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
